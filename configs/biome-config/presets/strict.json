{
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noConsole": "error",
        "noDebugger": "error"
      },
      "style": {
        "noNegationElse": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "complexity": {
        "noForEach": "error",
        "noStaticOnlyClass": "error"
      }
    }
  }
}
