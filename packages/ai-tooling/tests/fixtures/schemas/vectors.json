{
  "description": "Positive and negative validation vectors, one entry per schema root. Negative cases name the property that must fail so a regression cannot pass by rejecting for the wrong reason.",
  "config": {
    "invalid": [
      {
        "name": "unknown top-level property",
        "document": {
          "version": 1,
